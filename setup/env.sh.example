# MoPlan runtime environment. Copy this file to setup/env.sh, edit the paths,
# and load it in every shell that runs MoPlan code:
#
#   cp setup/env.sh.example setup/env.sh
#   source setup/env.sh
#
# Unedited, every path points to the default location used by
# setup/download_weights.py and setup/install_third_party.sh (under the repo).

MOPLAN_REPO=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)
export MOPLAN_REPO

# Wan2.2-I2V-A14B-Diffusers directory (model_index.json, transformer/, transformer_2/, vae/, ...)
export WAN_MODEL_DIR=${WAN_MODEL_DIR:-$MOPLAN_REPO/weights/Wan2.2-I2V-A14B-Diffusers}
# MoPlan weights (stage1/, stage2/high/, stage2/low/)
export MOPLAN_WEIGHTS=${MOPLAN_WEIGHTS:-$MOPLAN_REPO/weights/MoPlan}
# SAM 2.1 Hiera-L checkpoint file
export SAM2_CHECKPOINT=${SAM2_CHECKPOINT:-$MOPLAN_REPO/weights/sam2/sam2.1_hiera_large.pt}
# co-tracker git checkout (the directory that contains the cotracker/ package)
export COTRACKER_REPO=${COTRACKER_REPO:-$MOPLAN_REPO/third_party/co-tracker}
# CoTracker3 offline checkpoint file
export COTRACKER_CKPT=${COTRACKER_CKPT:-$MOPLAN_REPO/weights/cotracker3/scaled_offline.pth}

# Optional: an ffmpeg / ffprobe with libx264 for the evaluation steps that call them
# from PATH (docs/INSTALL.md, "Video tools"; MoPlan's own code does not need it).
# export PATH=$MOPLAN_REPO/third_party/ffmpeg/bin:$PATH

# Optional roots read by the data-building and training launchers (see their docs):
# export MOPLAN_DATA=/path/to/built/data
# export MOPLAN_WORK_DIR=/path/to/work

# The code runs from the repository root without installation.
export PYTHONPATH=$MOPLAN_REPO${PYTHONPATH:+:$PYTHONPATH}

# Settings of the reference runs. All weights are read from local paths, so the
# Hugging Face clients stay offline (setup/download_weights.py ignores this).
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export TQDM_DISABLE=1
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
